---
import { offersFor, goHref, MAX_PARTNERS } from '../lib/affiliates';
interface Props { place: string; region: string; tag: string; used?: string[] }
const { place, region, tag, used = [] } = Astro.props;
// Skip partners already linked in the text, and keep the page to MAX_PARTNERS different partners in total.
const offers = offersFor(place, region).filter((o) => !used.includes(o.id)).slice(0, Math.max(0, MAX_PARTNERS - used.length));
---
{offers.length > 0 && (
<aside class="book" aria-labelledby="book-h">
  <h3 id="book-h">{place ? `Book smart for ${place}` : 'Book smart'}</h3>
  <p class="book-sub">Our picks for a budget trip. Prices change, so compare before you pay.</p>
  <ul class="book-list">
    {offers.map((o) => (
      <li>
        <div>
          <strong>{o.headline}</strong>
          <span>{o.blurb}</span>
        </div>
        <a class="btn" href={goHref(o.id, tag)} target="_blank" rel="sponsored noopener" data-astro-reload data-astro-prefetch="false">{o.cta}</a>
      </li>
    ))}
  </ul>
  <p class="book-note">These are affiliate links: Voyagelo may earn a commission if you book, at no extra cost to you. <a href="/p/affiliate-disclosure.html">How this works</a>.</p>
</aside>
)}
