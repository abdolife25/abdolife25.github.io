---
import Base from './Base.astro';
import GuideCard from '../components/GuideCard.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import { getCollection } from 'astro:content';
import { SITE, slugify, placeOf, regionOf, readMins, cardData } from '../lib/site';
interface Props { entry: any; kind: 'post' | 'page'; rendered: any }
const { entry, kind, rendered } = Astro.props;
const d = entry.data;
const { Content, headings } = rendered;
const toc = (headings || []).filter((h: any) => h.depth === 2).slice(0, 24);
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const place = placeOf(d.labels), region = regionOf(d.labels);
const calcHref = `/tools/trip-budget-calculator.html${place ? `?dest=${encodeURIComponent(place)}` : ''}`;
let related: any[] = [];
if (kind === 'post') {
  const all = (await getCollection('posts')).filter((p) => p.id !== entry.id).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
  const same = all.filter((p) => place && placeOf(p.data.labels) === place);
  const near = all.filter((p) => !same.includes(p) && regionOf(p.data.labels) === region);
  related = [...same, ...near, ...all.filter((p) => !same.includes(p) && !near.includes(p))].slice(0, 3).map(cardData);
}
const isPost = kind === 'post';
const tag = slugify(String(entry.id)).slice(0, 50);
const shareUrl = encodeURIComponent(new URL(d.path, SITE.url).href), shareText = encodeURIComponent(d.title);
const shareImg = d.heroImage ? encodeURIComponent(d.heroImage.startsWith('http') ? d.heroImage : new URL(d.heroImage, SITE.url).href) : '';
const shares = [
  { name: 'Facebook', url: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}` },
  { name: 'X', url: `https://x.com/intent/post?url=${shareUrl}&text=${shareText}` },
  { name: 'Pinterest', url: `https://www.pinterest.com/pin/create/button/?url=${shareUrl}&description=${shareText}${shareImg ? `&media=${shareImg}` : ''}` },
  { name: 'WhatsApp', url: `https://wa.me/?text=${shareText}%20${shareUrl}` },
];
---
<Base title={d.title} description={d.description} path={d.path} image={d.heroImage} type={isPost ? 'article' : 'website'}>
  {isPost && <div class="progress" data-progress></div>}
  <div class="wrap post-head">
    {isPost && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/destinations.html">Destinations</a>
        {place && <><span>/</span><a href={`/tags/${slugify(place)}.html`}>{place}</a></>}
      </nav>
    )}
    <h1>{d.title}</h1>
    {isPost && (
      <div class="meta">
        <span>{readMins(entry.body)} min read</span>
        <span>Published {fmt(d.pubDate)}</span>
        {d.updatedDate && +d.updatedDate - +d.pubDate > 7 * 864e5 && <span>Updated {fmt(d.updatedDate)}</span>}
        <button type="button" class="linkbtn" data-copy-link>Copy link</button>
      </div>
    )}
  </div>
  <div class={isPost ? 'wrap post-grid' : 'wrap'} style={isPost ? undefined : 'max-width:760px'}>
    <article class="prose" data-prose>
      {isPost && <p class="disclosure">This guide contains affiliate links. If you book through them, Voyagelo may earn a commission at no extra cost to you. <a href="/p/affiliate-disclosure.html">How this works</a>.</p>}
      {isPost && toc.length > 2 && (
        <details class="toc toc-mobile" data-toc>
          <summary>On this page</summary>
          <ol>{toc.map((h: any) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
      <Content />
      {isPost && <AffiliateBox place={place} region={region} tag={tag} />}
      {isPost && (
        <div class="share">
          <strong>Share this guide</strong>
          <div class="chips">
            <button type="button" class="chip" data-share data-title={d.title} hidden>Share</button>
            {shares.map((x) => <a class="chip" href={x.url} target="_blank" rel="noopener">{x.name}</a>)}
            <button type="button" class="chip" data-copy-link>Copy link</button>
          </div>
        </div>
      )}
      {isPost && (
        <div class="plan plan-inline">
          <h3>Price {place ? `your ${place} trip` : 'this trip'}</h3>
          <p>Enter your own flight, stay and daily costs and get a total with a safety buffer.</p>
          <div><a class="btn sun" href={calcHref}>Open the budget calculator</a></div>
        </div>
      )}
    </article>
    {isPost && (
      <aside class="rail">
        {toc.length > 2 && (
          <nav class="toc" data-toc aria-label="On this page">
            <strong>On this page</strong>
            <ol>{toc.map((h: any) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="plan">
          <h3>Price {place ? `your ${place} trip` : 'this trip'}</h3>
          <p>Turn your own prices into a total with a safety buffer.</p>
          <a class="btn sun" href={calcHref}>Budget calculator</a>
          <a class="btn" style="border-color:currentColor;color:inherit" href="/tools/packing-checklist.html">Packing checklist</a>
        </div>
      </aside>
    )}
  </div>
  {related.length > 0 && (
    <section class="block"><div class="wrap">
      <div class="block-head"><h2>Keep planning</h2></div>
      <div class="grid">{related.map((c) => <GuideCard card={c} />)}</div>
    </div></section>
  )}
  {isPost && SITE.emailSignupUrl && (
    <section class="block"><div class="wrap"><div class="signup">
      <h2>Get one budget-travel deal email a week</h2>
      <a class="btn primary" href={SITE.emailSignupUrl}>Join the list</a>
    </div></div></section>
  )}
</Base>
