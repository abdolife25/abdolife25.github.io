---
import Base from '../layouts/Base.astro';
---
<Base title="Free trip planning tools" description="Free travel tools: a trip budget calculator and a packing checklist that saves your progress.">
  <div class="wrap page-head"><h1>Trip tools</h1><p>Free tools that work with your own numbers. Nothing to install and no sign-up.</p></div>
  <div class="wrap"><div class="tools">
    <div class="tool"><h3>Trip budget calculator</h3><p>Add flights, stays and daily costs. See the total, the cost per person and a safety buffer, then share it with a link.</p><a class="btn sun" href="/tools/trip-budget-calculator.html">Calculate a trip budget</a></div>
    <div class="tool"><h3>Packing checklist</h3><p>Tick items off as you pack and add your own. Your list is saved on this device.</p><a class="btn sun" href="/tools/packing-checklist.html">Open the checklist</a></div>
  </div></div>
</Base>
