---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import { REGIONS, cardData, slugify } from '../lib/site';
const cards = (await getCollection('posts')).sort((a, b) => +b.data.pubDate - +a.data.pubDate).map(cardData);
const banners: Record<string, string> = { Asia: 'asia', Europe: 'europe', Americas: 'americas', 'Middle East & Africa': 'mea' };
const groups = [...Object.keys(REGIONS), 'Worldwide'].map((r) => ({ name: r, cards: cards.filter((c) => c.region === r) })).filter((g) => g.cards.length);
---
<Base title="Budget travel destinations" description="Every Voyagelo budget travel guide grouped by region, with real trip costs in US dollars, where to stay and the best time to go.">
  <div class="wrap page-head">
    <h1>Destinations</h1>
    <p>Every guide, grouped by region. Jump to one:</p>
    <div class="chips" style="margin-top:14px">{groups.map((g) => <a class="chip" href={`#${slugify(g.name)}`}>{g.name} <small>{g.cards.length}</small></a>)}</div>
  </div>
  {groups.map((g) => (
    <section class="block" id={slugify(g.name)} style="padding-top:30px"><div class="wrap">
      {banners[g.name] ? (
        <div class="region-banner"><img src={`/images/hero/${banners[g.name]}-1200.webp`} width="1200" height="462" alt="" loading="lazy" decoding="async"><h2>{g.name}</h2><span>{g.cards.length} {g.cards.length === 1 ? 'guide' : 'guides'}</span></div>
      ) : <div class="block-head"><h2>{g.name}</h2></div>}
      <div class="grid">{g.cards.map((c) => <GuideCard card={c} />)}</div>
    </div></section>
  ))}
</Base>
