---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { slugify } from '../lib/site';
const posts = (await getCollection('posts')).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const by = new Map<string, typeof posts>();
posts.forEach((p) => p.data.labels.forEach((l) => by.set(l, [...(by.get(l) ?? []), p])));
const tags = [...by.keys()].filter((t) => t !== 'Budget Travel').sort();
---
<Base title="Budget travel destinations" description="Travel guides by destination: costs, where to stay and the best time to go.">
  <div class="wrap" style="padding-bottom:24px">
    <h1>Destinations</h1>
    {tags.map((t) => (
      <section aria-labelledby={slugify(t)}>
        <h2 id={slugify(t)}><a href={`/tags/${slugify(t)}.html`} style="color:inherit;text-decoration:none">{t}</a></h2>
        <ul>{by.get(t)!.map((p) => <li><a href={p.data.path}>{p.data.title}</a></li>)}</ul>
      </section>
    ))}
  </div>
</Base>
